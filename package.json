{
  "name": "essayz",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "bun run build && vite preview",
    "deploy": "bun run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply essayz-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply essayz-db --remote",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/unifrakturcook": "^5.3.0",
    "dompurify": "^3.2.6",
    "marked": "^16.1.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.11.0",
    "@cloudflare/workers-types": "^4.20250726.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.6",
    "vitest": "^3.2.4",
    "wrangler": "^4.26.1"
  }
}
